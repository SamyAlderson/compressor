# .gitignore
# ignore node_modules and npm cache
node_modules/
npm-debug.log
npm-debug.log.*

# ignore rust artifacts
target/

# ignore python cache
.cache
__pycache__/

# ignore IDE files
.idea/
.vscode/

# ignore docker stuff
docker-compose.yml
docker-compose.yaml
docker/

# ignore other stuff
.env
config.json
config.yaml
config.yml